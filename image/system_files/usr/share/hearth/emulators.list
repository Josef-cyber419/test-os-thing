# Emulators installed from Flathub on first boot by hearth-flatpak-setup.
# ES-DE detects each one automatically. They're also given access to ~/ROMs,
# ~/BIOS and other drives, so games can live on a second disk.
# One app ID per line; see docs/EMULATION.md for what each one covers.

# Multi-system: NES, SNES, Game Boy/Color/Advance, Genesis, and many more
org.libretro.RetroArch
# Nintendo 64
com.github.Rosalie241.RMG
# GameCube and Wii
org.DolphinEmu.dolphin-emu
# Wii U
info.cemu.Cemu
# Nintendo DS
net.kuribo64.melonDS
# Nintendo 3DS
org.azahar_emu.Azahar
# Nintendo Switch
dev.eden_emu.eden
# PlayStation
org.duckstation.DuckStation
# PlayStation 2
net.pcsx2.PCSX2
# PlayStation 3
net.rpcs3.RPCS3
# PlayStation 4 (early days)
net.shadps4.shadPS4
# PSP
org.ppsspp.PPSSPP
# Original Xbox
app.xemu.xemu
# Arcade
org.mamedev.MAME
