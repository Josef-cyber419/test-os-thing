#!/usr/bin/bash
# Open a streaming site full-screen in Chrome's kiosk mode, with a dedicated
# profile so logins persist separately from any desktop browsing.
# Controller: hold the Guide/Home button to return to Hearth.
set -euo pipefail
url=${1:?usage: hearth-web URL}
args=(--kiosk --start-fullscreen --no-first-run --noerrdialogs
      --disable-session-crashed-bubble --autoplay-policy=no-user-gesture-required
      "--user-data-dir=$HOME/.var/app/com.google.Chrome/hearth-tv")
case "$url" in
    # youtube.com/tv only serves its couch UI to TV user agents.
    *youtube.com/tv*)
        args+=("--user-agent=Mozilla/5.0 (SMART-TV; Linux; Tizen 6.0) AppleWebKit/537.36 (KHTML, like Gecko) 85.0.4183.93/6.0 TV Safari/537.36")
        ;;
esac
exec flatpak run com.google.Chrome "${args[@]}" "$url"
