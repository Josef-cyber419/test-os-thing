#!/usr/bin/bash
# Privileged helper (allowed via /etc/sudoers.d/hearth): set EFI BootNext to
# a known OS. Only accepts fixed target names, never arbitrary entries.
set -euo pipefail
case "${1:-}" in
    windows) label='Windows Boot Manager' ;;
    *) echo "hearth-bootnext: unknown target '${1:-}'" >&2; exit 2 ;;
esac
entry=$(efibootmgr | awk -v label="$label" '
    match($0, /^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]\*? /) {
        name = substr($0, RLENGTH + 1)
        if (index(name, label) == 1) { print substr($0, 5, 4); exit }
    }')
if [[ -z "$entry" ]]; then
    echo "hearth-bootnext: no EFI boot entry named '$label'" >&2
    exit 1
fi
efibootmgr --bootnext "$entry" >/dev/null
echo "Next boot: $label (Boot$entry)"
