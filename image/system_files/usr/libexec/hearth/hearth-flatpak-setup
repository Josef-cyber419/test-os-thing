#!/usr/bin/bash
# Install Hearth's default apps from Flathub. Each app is attempted once:
# if you uninstall one later, it stays uninstalled.
set -uo pipefail
list=/usr/share/hearth/flatpaks.list
done_file=/var/lib/hearth/flatpaks-attempted
mkdir -p "$(dirname "$done_file")"
touch "$done_file"

flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

grep -Ev '^\s*(#|$)' "$list" | while read -r app; do
    grep -qxF "$app" "$done_file" && continue
    echo "Installing $app"
    if flatpak install --system --noninteractive --or-update flathub "$app"; then
        echo "$app" >> "$done_file"
    else
        echo "Failed to install $app; will retry next boot" >&2
    fi
done
